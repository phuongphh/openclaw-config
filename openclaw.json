{
  "meta": {
    "lastTouchedVersion": "2026.3.2",
    "lastTouchedAt": "2026-03-09T05:13:08.085Z"
  },
  "env": {
    "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}",
    "OPENAI_CODEX_KEY": "${OPENAI_CODEX_KEY}",
    "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}",
    "DEEPSEEK_API_KEY": "${DEEPSEEK_API_KEY}",
    "MOONSHOT_API_KEY": "${MOONSHOT_API_KEY}",
    "TELEGRAM_BOT_TOKEN_MAIN": "${TELEGRAM_BOT_TOKEN_MAIN}",
    "TELEGRAM_BOT_TOKEN_PM": "${TELEGRAM_BOT_TOKEN_PM}"
  },
  "auth": {
    "profiles": {
      "anthropic:default": {
        "provider": "anthropic",
        "mode": "api_key"
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "deepseek": {
        "baseUrl": "https://api.deepseek.com/v1",
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-chat",
            "name": "DeepSeek V3",
            "reasoning": false,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0.27,
              "output": 1.1,
              "cacheRead": 0.07,
              "cacheWrite": 0
            },
            "contextWindow": 128000,
            "maxTokens": 8192
          },
          {
            "id": "deepseek-reasoner",
            "name": "DeepSeek R1",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0.55,
              "output": 2.19,
              "cacheRead": 0.14,
              "cacheWrite": 0
            },
            "contextWindow": 128000,
            "maxTokens": 64000
          }
        ]
      },
      "openai": {
        "baseUrl": "https://api.openai.com/v1",
        "models": [
          {
            "id": "gpt-4.1",
            "name": "GPT-4.1",
            "reasoning": true,
            "input": [
              "text"
            ],
            "cost": {
              "input": 2,
              "output": 8,
              "cacheRead": 0.5,
              "cacheWrite": 0
            },
            "contextWindow": 128000,
            "maxTokens": 4096
          }
        ]
      },
      "openrouter": {
        "baseUrl": "https://openrouter.ai/api/v1",
        "api": "openai-completions",
        "models": [
          {
            "id": "auto",
            "name": "OpenRouter Auto",
            "reasoning": false,
            "input": [
              "text",
              "image"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 200000,
            "maxTokens": 8192
          }
        ]
      },
      "moonshot": {
        "baseUrl": "https://api.moonshot.ai/v1",
        "api": "openai-completions",
        "models": [
          {
            "id": "kimi-k2.5",
            "name": "Kimi K2.5",
            "reasoning": false,
            "input": [
              "text",
              "image"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 256000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "deepseek/deepseek-chat",
        "fallbacks": [
          "anthropic/claude-haiku-4-5-20251001"
        ]
      },
      "models": {
        "deepseek/deepseek-chat": {
          "alias": "DeepSeek"
        },
        "deepseek/deepseek-reasoner": {
          "alias": "DeepSeek-R1"
        },
        "anthropic/claude-haiku-4-5-20251001": {
          "alias": "Haiku"
        },
        "anthropic/claude-sonnet-4-5-20250929": {
          "alias": "Sonnet"
        },
        "anthropic/claude-opus-4-5": {
          "alias": "Opus"
        },
        "openai/gpt-4.1": {
          "alias": "GPT-4.1"
        }
      },
      "workspace": "/Users/phanphuong/.openclaw/workspace-pm",
      "compaction": {
        "mode": "safeguard"
      },
      "heartbeat": {
        "every": "30m",
        "model": "deepseek/deepseek-chat"
      },
      "maxConcurrent": 1
    }
  },
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "hooks": {
    "internal": {
      "enabled": true,
      "entries": {
        "session-memory": {
          "enabled": true
        },
        "command-logger": {
          "enabled": true
        },
        "boot-md": {
          "enabled": true
        }
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "pairing",
      "groupPolicy": "allowlist",
      "groupAllowFrom": [1863547567],
      "allowFrom": [1863547567],
      "streaming": "partial",
      "accounts": {
        "main": {
          "dmPolicy": "pairing",
          "botToken": "${TELEGRAM_BOT_TOKEN_MAIN}",
          "allowFrom": [
            1863547567
          ],
          "groupPolicy": "allowlist",
          "streaming": "partial"
        },
        "pm": {
          "dmPolicy": "pairing",
          "botToken": "${TELEGRAM_BOT_TOKEN_PM}",
          "allowFrom": [
            1863547567
          ],
          "groupPolicy": "allowlist",
          "streaming": "partial"
        },
        "default": {
          "dmPolicy": "pairing",
          "groupPolicy": "allowlist",
          "groupAllowFrom":[1863547567],
          "allowFrom":[1863547567],
          "streaming": "partial"
        }
      }
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "nodes": {
      "denyCommands": [
        "camera.snap",
        "camera.clip",
        "screen.record",
        "calendar.add",
        "contacts.add",
        "reminders.add"
      ]
    }
  },
  "skills": {
    "install": {
      "nodeManager": "npm"
    },
    "entries": {
      "otofun-chogioi": {
        "enabled": true,
        "env": {
          "OTOFUN_USERNAME": "${OTOFUN_USERNAME}",
          "OTOFUN_PASSWORD": "${OTOFUN_PASSWORD}"
        }
      },
      "ai-news-digest": {
        "enabled": true
      }
    }
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      }
    }
  }
}
