{"type":"message","id":"222aa848","parentId":"0509d2c6","timestamp":"2026-03-08T01:01:33.007Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Now I need to create the audio generation script. Let me create a script that chunks the text and calls the TTS API. According to the SKILL.md, I should use the Bệ hạ's custom TTS API at https://tts-enso.ai-enso.com/api/tts","thinkingSignature":""},{"type":"toolCall","id":"toolu_01NkC2m1ZDDUyxSXTBhAXLDU","name":"exec","arguments":{"command":"cat > /tmp/gen_audio.py << 'EOF'\n#!/usr/bin/env python3\nimport json\nimport subprocess\nimport os\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pathlib import Path\nfrom datetime import datetime\nimport sys\n\nTTS_API = \"https://tts-enso.ai-enso.com/api/tts\"\nVOICE = \"voice1\"\nWORKSPACE_AUDIO = os.path.expanduser(\"~/.openclaw/workspace/audio\")\nCHUNK_SIZE = 40  # words per chunk\n\ndef ensure_audio_dir():\n    Path(WORKSPACE_AUDIO).mkdir(parents=True, exist_ok=True)\n\ndef split_into_chunks(text, chunk_size=CHUNK_SIZE):\n    words = text.split()\n    chunks = []\n    for i in range(0, len(words), chunk_size):\n        chunk = \" \".join(words[i:i+chunk_size])\n        chunks.append(chunk)\n    return chunks\n\ndef call_tts_api(chunk_text, chunk_id):\n    try:\n        cmd = [\n            \"curl\", \"--location\", TTS_API,\n            \"--header\", \"Content-Type: application/json\",\n            \"--data\", json.dumps({\"text\": chunk_text, \"voice\": VOICE}),\n            \"--silent\", \"--max-time\", \"30\"\n        ]\n        result = subprocess.run(cmd, capture_output=True, timeout=35)\n        if result.returncode == 0 and result.stdout:\n            return (chunk_id, result.stdout)\n        else:\n            print(f\"❌ Chunk {chunk_id} TTS failed\", file=sys.stderr)\n            return None\n    except Exception as e:\n        print(f\"❌ Chunk {chunk_id} error: {e}\", file=sys.stderr)\n        return None\n\ndef generate_audio(report_text, date_str):\n    ensure_audio_dir()\n    \n    print(f\"📝 Splitting text into chunks...\", file=sys.stderr)\n    chunks = split_into_chunks(report_text)\n    print(f\"   {len(chunks)} chunks created\", file=sys.stderr)\n    \n    chunk_files = {}\n    \n    print(f\"🎙️  Calling TTS API (max 3 workers)...\", file=sys.stderr)\n    with ThreadPoolExecutor(max_workers=3) as executor:\n        futures = {\n            executor.submit(call_tts_api, chunk, i): i \n            for i, chunk in enumerate(chunks)\n        }\n        for future in as_completed(futures):\n            result = future.result()\n            if result:\n                chunk_id, wav_bytes = result\n                chunk_file = f\"/tmp/chunk_{chunk_id:02d}.wav\"\n                with open(chunk_file, \"wb\") as f:\n                    f.write(wav_bytes)\n                chunk_files[chunk_id] = chunk_file\n                print(f\"   ✓ Chunk {chunk_id} saved\", file=sys.stderr)\n    \n    if not chunk_files:\n        print(\"❌ No chunks generated\", file=sys.stderr)\n        return None\n    \n    print(f\"🔗 Concatenating with ffmpeg...\", file=sys.stderr)\n    sorted_chunks = sorted(chunk_files.items())\n    \n    concat_file = \"/tmp/concat.txt\"\n    with open(concat_file, \"w\") as f:\n        for _, path in sorted_chunks:\n            f.write(f\"file '{path}'\\n\")\n    \n    output_file = os.path.join(WORKSPACE_AUDIO, f\"ai_news_{date_str}.wav\")\n    cmd = [\n        \"ffmpeg\", \"-f\", \"concat\", \"-safe\", \"0\",\n        \"-i\", concat_file,\n        \"-c\", \"copy\",\n        \"-y\",\n        output_file\n    ]\n    \n    result = subprocess.run(cmd, capture_output=True)\n    if result.returncode == 0:\n        print(f\"✅ Audio file: {output_file}\", file=sys.stderr)\n        \n        for _, path in sorted_chunks:\n            try:\n                os.remove(path)\n            except:\n                pass\n        os.remove(concat_file)\n        \n        return output_file\n    else:\n        print(f\"❌ ffmpeg failed: {result.stderr.decode()}\", file=sys.stderr)\n        return None\n\nif __name__ == \"__main__\":\n    if len(sys.argv) < 2:\n        print(\"Usage: gen_audio.py <report_text> [date_str]\")\n        sys.exit(1)\n    \n    report_text = sys.argv[1]\n    date_str = sys.argv[2] if len(sys.argv) > 2 else datetime.now().strftime(\"%Y%m%d\")\n    \n    audio_file = generate_audio(report_text, date_str)\n    if audio_file:\n        print(f\"SUCCESS:{audio_file}\")\n    else:\n        sys.exit(1)\nEOF\n\npython3 /tmp/gen_audio.py \"$(cat /tmp/report_text.txt)\" \"20260308\" 2>&1\n","timeout":900}}],"api":"anthropic-messages","provider":"anthropic","model":"claude-haiku-4-5-20251001","usage":{"input":11,"output":1436,"cacheRead":25204,"cacheWrite":1528,"totalTokens":28179,"cost":{"input":0.000011,"output":0.007180000000000001,"cacheRead":0.0025204000000000003,"cacheWrite":0.0019100000000000002,"total":0.0116214}},"stopReason":"toolUse","timestamp":1772931684042}}
