{"type":"message","id":"49ca6f3d","parentId":"1aca2751","timestamp":"2026-03-02T16:06:31.356Z","message":{"role":"assistant","content":[{"type":"text","text":"**3️⃣ Viết script authentication + task manager:**"},{"type":"toolCall","id":"toolu_01Qh3xzAPHJV8YSCEZPcWkhB","name":"write","arguments":{"file_path":"/Users/phanphuong/.openclaw/workspace/skills/microsoft-todo/scripts/todo_manager.py","content":"#!/usr/bin/env python3\n\"\"\"\nMicrosoft Todo Manager\n- Authenticate with personal account\n- Add, list, complete, delete tasks\n- Set reminders and notify via Telegram\n\"\"\"\n\nimport sys\nimport json\nimport requests\nfrom pathlib import Path\nfrom datetime import datetime, timedelta\nimport argparse\nimport os\n\n# Config\nEMAIL = \"haphuong.phan@live.com\"\nPASSWORD = os.environ.get(\"MICROSOFT_TODO_PASSWORD\", \"nhiphuong2011\")\nTOKEN_FILE = Path.home() / \".openclaw\" / \"credentials\" / \"microsoft_todo_token.json\"\nTELEGRAM_USER_ID = 1863547567\n\n# Microsoft Graph API endpoints\nGRAPH_API = \"https://graph.microsoft.com/v1.0\"\nAUTH_ENDPOINT = \"https://login.microsoft.com/common/oauth2/v2.0/token\"\nSCOPE = \"https://graph.microsoft.com/.default\"\n\nclass TodoManager:\n    def __init__(self):\n        self.access_token = None\n        self.headers = {}\n        self.ensure_authenticated()\n    \n    def ensure_authenticated(self):\n        \"\"\"Load token or authenticate\"\"\"\n        if TOKEN_FILE.exists():\n            try:\n                with open(TOKEN_FILE) as f:\n                    data = json.load(f)\n                    self.access_token = data.get(\"access_token\")\n                    self.headers = {\"Authorization\": f\"Bearer {self.access_token}\"}\n                    print(\"✓ Token loaded from cache\")\n                    return\n            except:\n                pass\n        \n        # For personal account, we'd need interactive login\n        # For now, use device flow or direct API\n        self.authenticate_interactive()\n    \n    def authenticate_interactive(self):\n        \"\"\"Interactive authentication (simplified)\"\"\"\n        print(\"⚠️ Requires interactive Microsoft login\")\n        print(\"Opening browser for authentication...\")\n        # In production, use device flow or MSAL library\n        raise NotImplementedError(\"Implement MSAL or device flow\")\n    \n    def get_tasks(self, list_name=\"Inbox\"):\n        \"\"\"Fetch tasks from a list\"\"\"\n        try:\n            # Get all lists\n            response = requests.get(\n                f\"{GRAPH_API}/me/todo/lists\",\n                headers=self.headers\n            )\n            \n            if response.status_code != 200:\n                print(f\"❌ Error: {response.status_code}\")\n                return None\n            \n            lists = response.json().get(\"value\", [])\n            target_list = next((l for l in lists if l[\"displayName\"] == list_name), None)\n            \n            if not target_list:\n                print(f\"❌ List '{list_name}' not found\")\n                return None\n            \n            # Get tasks in this list\n            list_id = target_list[\"id\"]\n            response = requests.get(\n                f\"{GRAPH_API}/me/todo/lists/{list_id}/tasks\",\n                headers=self.headers\n            )\n            \n            if response.status_code == 200:\n                return response.json().get(\"value\", [])\n            else:\n                print(f\"❌ Error fetching tasks: {response.status_code}\")\n                return None\n                \n        except Exception as e:\n            print(f\"❌ Exception: {str(e)}\")\n            return None\n    \n    def add_task(self, title, due_date=None, reminder_minutes=None, list_name=\"Inbox\"):\n        \"\"\"Add new task\"\"\"\n        try:\n            # Get list ID\n            response = requests.get(\n                f\"{GRAPH_API}/me/todo/lists\",\n                headers=self.headers\n            )\n            \n            lists = response.json().get(\"value\", [])\n            target_list = next((l for l in lists if l[\"displayName\"] == list_name), None)\n            \n            if not target_list:\n                print(f\"❌ List '{list_name}' not found\")\n                return False\n            \n            list_id = target_list[\"id\"]\n            \n            # Create task\n            task_data = {\n                \"title\": title,\n                \"isReminderOn\": reminder_minutes is not None,\n            }\n            \n            if due_date:\n                task_data[\"dueDateTime\"] = {\n                    \"dateTime\": due_date,\n                    \"timeZone\": \"Asia/Saigon\"\n                }\n            \n            if reminder_minutes:\n                task_data[\"reminderMinutesBeforeStart\"] = reminder_minutes\n            \n            response = requests.post(\n                f\"{GRAPH_API}/me/todo/lists/{list_id}/tasks\",\n                headers=self.headers,\n                json=task_data\n            )\n            \n            if response.status_code == 201:\n                task = response.json()\n                print(f\"✓ Task created: {task['id']}\")\n                return task\n            else:\n                print(f\"❌ Error: {response.status_code} - {response.text}\")\n                return False\n                \n        except Exception as e:\n            print(f\"❌ Exception: {str(e)}\")\n            return False\n    \n    def complete_task(self, task_id, list_name=\"Inbox\"):\n        \"\"\"Mark task as completed\"\"\"\n        try:\n            # Get list ID\n            response = requests.get(\n                f\"{GRAPH_API}/me/todo/lists\",\n                headers=self.headers\n            )\n            \n            lists = response.json().get(\"value\", [])\n            target_list = next((l for l in lists if l[\"displayName\"] == list_name), None)\n            \n            if not target_list:\n                return False\n            \n            list_id = target_list[\"id\"]\n            \n            # Update task status\n            response = requests.patch(\n                f\"{GRAPH_API}/me/todo/lists/{list_id}/tasks/{task_id}\",\n                headers=self.headers,\n                json={\"status\": \"completed\"}\n            )\n            \n            if response.status_code == 200:\n                print(f\"✓ Task marked as completed\")\n                return True\n            else:\n                print(f\"❌ Error: {response.status_code}\")\n                return False\n                \n        except Exception as e:\n            print(f\"❌ Exception: {str(e)}\")\n            return False\n    \n    def delete_task(self, task_id, list_name=\"Inbox\"):\n        \"\"\"Delete a task\"\"\"\n        try:\n            response = requests.get(\n                f\"{GRAPH_API}/me/todo/lists\",\n                headers=self.headers\n            )\n            \n            lists = response.json().get(\"value\", [])\n            target_list = next((l for l in lists if l[\"displayName\"] == list_name), None)\n            \n            if not target_list:\n                return False\n            \n            list_id = target_list[\"id\"]\n            \n            response = requests.delete(\n                f\"{GRAPH_API}/me/todo/lists/{list_id}/tasks/{task_id}\",\n                headers=self.headers\n            )\n            \n            if response.status_code == 204:\n                print(f\"✓ Task deleted\")\n                return True\n            else:\n                print(f\"❌ Error: {response.status_code}\")\n                return False\n                \n        except Exception as e:\n            print(f\"❌ Exception: {str(e)}\")\n            return False\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"Microsoft Todo Manager\")\n    subparsers = parser.add_subparsers(dest=\"command\")\n    \n    # Add task\n    add_parser = subparsers.add_parser(\"add\", help=\"Add new task\")\n    add_parser.add_argument(\"title\", help=\"Task title\")\n    add_parser.add_argument(\"--due-date\", help=\"Due date (YYYY-MM-DD)\")\n    add_parser.add_argument(\"--reminder\", help=\"Reminder (e.g., 1h, 30m)\")\n    add_parser.add_argument(\"--list\", default=\"Inbox\", help=\"List name\")\n    \n    # List tasks\n    list_parser = subparsers.add_parser(\"list\", help=\"List tasks\")\n    list_parser.add_argument(\"--list\", default=\"Inbox\", help=\"List name\")\n    \n    # Complete task\n    complete_parser = subparsers.add_parser(\"complete\", help=\"Mark task as completed\")\n    complete_parser.add_argument(\"task_id\", help=\"Task ID\")\n    complete_parser.add_argument(\"--list\", default=\"Inbox\", help=\"List name\")\n    \n    # Delete task\n    delete_parser = subparsers.add_parser(\"delete\", help=\"Delete task\")\n    delete_parser.add_argument(\"task_id\", help=\"Task ID\")\n    delete_parser.add_argument(\"--list\", default=\"Inbox\", help=\"List name\")\n    \n    args = parser.parse_args()\n    \n    if not args.command:\n        parser.print_help()\n        return\n    \n    manager = TodoManager()\n    \n    if args.command == \"add\":\n        manager.add_task(\n            args.title,\n            due_date=args.due_date,\n            list_name=args.list\n        )\n    \n    elif args.command == \"list\":\n        tasks = manager.get_tasks(args.list)\n        if tasks:\n            print(f\"\\n📋 Tasks in '{args.list}':\")\n            for task in tasks:\n                status = \"✓\" if task.get(\"status\") == \"completed\" else \"○\"\n                print(f\"  {status} {task['title']} (ID: {task['id']})\")\n    \n    elif args.command == \"complete\":\n        manager.complete_task(args.task_id, args.list)\n    \n    elif args.command == \"delete\":\n        manager.delete_task(args.task_id, args.list)\n\n\nif __name__ == \"__main__\":\n 