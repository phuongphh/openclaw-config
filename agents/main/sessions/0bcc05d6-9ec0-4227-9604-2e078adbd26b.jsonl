{"type":"message","id":"83bd042d","parentId":"f6e6c62f","timestamp":"2026-03-01T17:24:09.238Z","message":{"role":"assistant","content":[{"type":"text","text":"Bệ hạ confirm các chi tiết. Để tôi viết script Python + test luôn:"},{"type":"toolCall","id":"toolu_01JvYNJWRQnGwVXx7hrR1U6s","name":"write","arguments":{"file_path":"/Users/phanphuong/.openclaw/workspace/skills/ai-news-digest/scripts/tts_chunked.py","content":"#!/usr/bin/env python3\n\"\"\"\nTTS Chunked Audio Generator\n- Split text into 30-50 word chunks\n- Call TTS API for each chunk (parallel)\n- Concat with pydub\n- Output: single WAV file\n\"\"\"\n\nimport sys\nimport json\nimport re\nimport requests\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nfrom pydub import AudioSegment\nfrom pydub.utils import mediainfo\nimport time\n\n# Config\nTTS_API_URL = \"https://tts-enso.ai-enso.com/api/tts\"\nVOICE = \"voice1\"\nCHUNK_SIZE = 40  # words\nRETRY_COUNT = 2\nMAX_WORKERS = 5  # Parallel requests\n\ndef split_into_chunks(text, chunk_size=40):\n    \"\"\"\n    Split text into chunks of ~chunk_size words\n    Try to preserve sentence boundaries\n    \"\"\"\n    # Split by sentences first\n    sentences = re.split(r'(?<=[.!?])\\s+', text.strip())\n    \n    chunks = []\n    current_chunk = []\n    current_word_count = 0\n    \n    for sentence in sentences:\n        words = sentence.split()\n        sentence_word_count = len(words)\n        \n        # If adding this sentence exceeds chunk_size, save current chunk\n        if current_word_count + sentence_word_count > chunk_size and current_chunk:\n            chunks.append(' '.join(current_chunk))\n            current_chunk = []\n            current_word_count = 0\n        \n        current_chunk.extend(words)\n        current_word_count += sentence_word_count\n    \n    # Don't forget last chunk\n    if current_chunk:\n        chunks.append(' '.join(current_chunk))\n    \n    return chunks\n\n\ndef call_tts_api(chunk_text, voice=VOICE, retry=0):\n    \"\"\"\n    Call TTS API for a single chunk\n    Returns: (chunk_index, audio_bytes, success)\n    \"\"\"\n    try:\n        payload = {\n            \"text\": chunk_text,\n            \"voice\": voice\n        }\n        \n        print(f\"  [API] Chunk {chunk_text[:30]}... (retry={retry})\")\n        \n        response = requests.post(\n            TTS_API_URL,\n            json=payload,\n            headers={'Content-Type': 'application/json'},\n            timeout=30\n        )\n        \n        if response.status_code == 200:\n            print(f\"  ✓ Success: {len(response.content)} bytes\")\n            return response.content\n        else:\n            print(f\"  ✗ Error: {response.status_code}\")\n            return None\n            \n    except Exception as e:\n        print(f\"  ✗ Exception: {str(e)}\")\n        return None\n\n\ndef tts_chunk_with_retry(chunk_idx, chunk_text, max_retries=RETRY_COUNT):\n    \"\"\"\n    Call TTS with retry logic\n    Returns: (chunk_idx, audio_bytes) or (chunk_idx, None)\n    \"\"\"\n    for attempt in range(max_retries):\n        audio = call_tts_api(chunk_text, retry=attempt)\n        if audio:\n            return (chunk_idx, audio)\n        \n        if attempt < max_retries - 1:\n            time.sleep(1)  # Wait before retry\n    \n    print(f\"  ✗ FAILED after {max_retries} retries\")\n    return (chunk_idx, None)\n\n\ndef concat_wav_files(audio_chunks):\n    \"\"\"\n    Concatenate WAV audio chunks using pydub\n    audio_chunks: list of (idx, audio_bytes)\n    Returns: combined AudioSegment\n    \"\"\"\n    combined = None\n    \n    for idx, audio_bytes in sorted(audio_chunks, key=lambda x: x[0]):\n        if audio_bytes is None:\n            print(f\"  ⚠ Skipping chunk {idx} (failed)\")\n            continue\n        \n        try:\n            # Load WAV from bytes\n            segment = AudioSegment.from_file(\n                filename=audio_bytes,\n                format=\"wav\"\n            )\n            \n            if combined is None:\n                combined = segment\n            else:\n                combined += segment\n            \n            print(f\"  ✓ Concatenated chunk {idx}\")\n            \n        except Exception as e:\n            print(f\"  ✗ Error loading chunk {idx}: {str(e)}\")\n    \n    return combined\n\n\ndef generate_audio(text, output_path=\"/tmp/ai_news_chunked.wav\"):\n    \"\"\"\n    Main function: split text, call TTS parallel, concat, save\n    \"\"\"\n    print(\"\\n\" + \"=\"*60)\n    print(\"TTS CHUNKED AUDIO GENERATOR\")\n    print(\"=\"*60)\n    \n    # Step 1: Split into chunks\n    print(\"\\n[Step 1] Splitting text into chunks...\")\n    chunks = split_into_chunks(text, CHUNK_SIZE)\n    print(f\"  → Total chunks: {len(chunks)}\")\n    for i, chunk in enumerate(chunks[:3]):  # Show first 3\n        print(f\"    {i}: {chunk[:50]}...\")\n    \n    # Step 2: Call TTS API in parallel\n    print(f\"\\n[Step 2] Calling TTS API (max_workers={MAX_WORKERS})...\")\n    audio_chunks = []\n    \n    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:\n        futures = {\n            executor.submit(\n                tts_chunk_with_retry,\n                idx,\n                chunk\n            ): idx\n            for idx, chunk in enumerate(chunks)\n        }\n        \n        for future in as_completed(futures):\n            try:\n                result = future.result()\n                audio_chunks.append(result)\n            except Exception as e:\n                print(f\"  ✗ Thread error: {str(e)}\")\n    \n    print(f\"  → Received {len([c for c in audio_chunks if c[1] is not None])}/{len(chunks)} chunks\")\n    \n    # Step 3: Concatenate\n    print(\"\\n[Step 3] Concatenating audio chunks (pydub)...\")\n    combined_audio = concat_wav_files(audio_chunks)\n    \n    if combined_audio is None:\n        print(\"  ✗ ERROR: No audio chunks to concatenate!\")\n        return False\n    \n    # Step 4: Export\n    print(f\"\\n[Step 4] Exporting to {output_path}...\")\n    combined_audio.export(output_path, format=\"wav\")\n    \n    file_size = Path(output_path).stat().st_size\n    duration_ms = len(combined_audio)\n    duration_s = duration_ms / 1000\n    \n    print(f\"  ✓ Success!\")\n    print(f\"  → File: {output_path}\")\n    print(f\"  → Size: {file_size / 1024:.1f} KB\")\n    print(f\"  → Duration: {duration_s:.1f}s\")\n    \n    return True\n\n\nif __name__ == \"__main__\":\n    # Test text\n    test_text = \"\"\"\n    Báo cáo tin công nghệ. Tuần này, cuộc đối đầu giữa Anthropic và Tổng thống Trump leo thang thành sự kiện chính trị lớn nhất trong ngành AI. \n    Sau khi Trump ra lệnh cấm Anthropic khỏi tất cả hệ thống chính phủ Mỹ vì công ty từ chối cung cấp Claude cho các hệ thống vũ khí tự động và giám sát hàng loạt, \n    một bản thư chung từ hơn 100 nhân viên tại Google DeepMind, OpenAI công khai ủng hộ lập trường của Anthropic. \n    Claude trở thành ứng dụng miễn phí số một trên App Store Mỹ. ChatGPT đạt 900 triệu người dùng toàn cầu. \n    Samsung Galaxy S26 Ultra tiếp tục thống trị phân khúc cao cấp với Privacy Display mới.\n    \"\"\"\n    \n    output_file = \"/tmp/ai_news_chunked.wav\"\n    \n    if generate_audio(test_text.strip(), output_file):\n        print(\"\\n\" + \"=\"*60)\n        print(f\"✅ Audio file ready: {output_file}\")\n        print(\"=\"*60)\n        sys.exit(0)\n    else:\n        print(\"\\n❌ Audio generation failed\")\n        sys.exit(1)\n"}}],"api":"anthropic-messages","provider":"anthropic","model":"claude-haiku-4-5-20251001","usage":{"input":0,"output":2315,"cacheRead":0,"cacheWrite":75278,"totalTokens":77593,"cost":{"input":0,"output":0.011575,"cacheRead":0,"cacheWrite":0.09409750000000001,"total":0.10567250000000002}},"stopReason":"toolUse","timestamp":1772385831185}}
