sult.stdout\n        return None\n    except Exception:\n        return None\n\ndef tts_chunk_with_retry(chunk_idx, chunk_text, max_retries=RETRY_COUNT):\n    for attempt in range(max_retries):\n        audio = call_tts_api_curl(chunk_text)\n        if audio:\n            return (chunk_idx, audio)\n        if attempt < max_retries - 1:\n            time.sleep(1)\n    return (chunk_idx, None)\n\ndef concat_wav_ffmpeg(audio_chunks, output_path):\n    temp_files = []\n    \n    for idx, audio_bytes in sorted(audio_chunks, key=lambda x: x[0]):\n        if audio_bytes is None:\n            continue\n        \n        try:\n            temp_path = tempfile.NamedTemporaryFile(suffix=\".wav\", delete=False)\n            temp_path.write(audio_bytes)\n            temp_path.close()\n            temp_files.append(temp_path.name)\n        except Exception:\n            pass\n    \n    if not temp_files:\n        return False\n    \n    concat_file = tempfile.NamedTemporaryFile(mode='w', suffix='.txt', delete=False)\n    for temp_file in temp_files:\n        concat_file.write(f\"file '{temp_file}'\\n\")\n    concat_file.close()\n    \n    try:\n        subprocess.run(\n            ['ffmpeg', '-f', 'concat', '-safe', '0', '-i', concat_file.name, '-c', 'copy', str(output_path), '-y'],\n            capture_output=True,\n            timeout=60\n        )\n        return output_path.exists()\n    except Exception:\n        return False\n    finally:\n        try:\n            Path(concat_file.name).unlink()\n            for f in temp_files:\n                Path(f).unlink()\n        except:\n            pass\n\n# Main\ntext = \"\"\"Báo cáo tin công nghệ. Tuần này chứng kiến bước ngoặt mới trong cuộc tranh chấp AI khi CEO Nvidia Jensen Huang công khai tuyên bố công ty đang rút lui khỏi OpenAI và Anthropic. Tuy nhiên, căng thẳng giữa Anthropic và OpenAI tiếp tục leo thang khi Dario Amodei gọi lời tuyên bố của OpenAI về thỏa thuận quân sự là nói dối trắng trợn. Cuộc tranh cãi quay quanh câu hỏi cơ bản: liệu OpenAI có thực sự giữ nguyên tắc an toàn hay chỉ là chiến lược PR để che đậy thỏa thuận quân sự. Các công ty quốc phòng đang chuyển sang các nhà cung cấp AI khác hoặc tự phát triển giải pháp nội bộ. Bên cạnh cuộc chiến chính trị, ngành đang chứng kiến sự dịch chuyển sang các mô hình độc lập hơn. Tại Việt Nam, các tin tức công nghệ cho thấy quan tâm ngày càng tăng về các vấn đề an ninh mạng liên quan đến AI. Tuần này làm nổi bật một xu hướng lo ngại: khi các quyết định chính trị và quân sự bắt đầu quyết định ai kiếm được hợp đồng AI lớn, thị trường bắt đầu phân mảnh. Nvidia đang bước ra khỏi cuộc chơi. Các công ty quốc phòng đang chuyển hướng. Các startup mới đang nhảy vào để giải quyết vấn đề độ tin cậy. Cuộc chạy đua AI không còn chỉ là về công nghệ mà về ai có khả năng điều phối các lợi ích chính trị, quân sự, và thương mại cùng một lúc.\"\"\"\n\nprint(\"🎙️ TTS Audio Generation (chunked)\")\nprint(f\"Output: {OUTPUT_PATH}\")\n\nchunks = split_into_chunks(text, CHUNK_SIZE)\nprint(f\"Chunks: {len(chunks)}\")\n\naudio_chunks = []\nwith ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:\n    futures = {executor.submit(tts_chunk_with_retry, idx, chunk): idx for idx, chunk in enumerate(chunks)}\n    for future in as_completed(futures):\n        audio_chunks.append(future.result())\n\nsuccess = len([c for c in audio_chunks if c[1] is not None])\nprint(f\"Success: {success}/{len(chunks)} chunks\")\n\nif concat_wav_ffmpeg(audio_chunks, OUTPUT_PATH):\n    size = OUTPUT_PATH.stat().st_size / 1024 / 1024\n    print(f\"✅ Audio saved: {size:.1f} MB\")\nelse:\n    print(\"❌ Failed\")\nEOF\n\npython3 /tmp/gen_audio_final.py","timeout":300}}],"api":"anthropic-messages","provider":"anthropic","model":"claude-haiku-4-5-20251001","usage":{"input":5,"output":1923,"cacheRead":56543,"cacheWrite":264,"totalTokens":58735,"cost":{"input":0.0000049999999999999996,"output":0.009615,"cacheRead":0.0056543,"cacheWrite":0.00033000000000000005,"total":0.0156043000000000