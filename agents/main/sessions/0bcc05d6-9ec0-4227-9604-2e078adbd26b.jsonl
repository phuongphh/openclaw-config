{"type":"message","id":"10bb05f1","parentId":"eef4d4f0","timestamp":"2026-03-05T10:20:51.689Z","message":{"role":"assistant","content":[{"type":"text","text":"Bệ hạ muốn dùng chunking script. Process đã kill xong. Để tôi chạy tts_chunked_curl.py:"},{"type":"toolCall","id":"toolu_015E6ks3kMcMzFRGvX6mEvfE","name":"exec","arguments":{"command":"cat > /tmp/test_chunked.py << 'EOF'\n#!/usr/bin/env python3\n\"\"\"\nTest TTS chunked with báo cáo text\n\"\"\"\nimport sys\nsys.path.insert(0, '/Users/phanphuong/.openclaw/workspace/skills/ai-news-digest/scripts')\n\n# Import từ tts_chunked_curl.py\nimport re\nimport subprocess\nimport tempfile\nfrom pathlib import Path\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nimport time\n\nTTS_API_URL = \"https://tts-enso.ai-enso.com/api/tts\"\nVOICE = \"voice1\"\nCHUNK_SIZE = 40\nRETRY_COUNT = 2\nMAX_WORKERS = 3\n\ndef split_into_chunks(text, chunk_size=40):\n    sentences = re.split(r'(?<=[.!?])\\s+', text.strip())\n    chunks = []\n    current_chunk = []\n    current_word_count = 0\n    \n    for sentence in sentences:\n        words = sentence.split()\n        sentence_word_count = len(words)\n        \n        if current_word_count + sentence_word_count > chunk_size and current_chunk:\n            chunks.append(' '.join(current_chunk))\n            current_chunk = []\n            current_word_count = 0\n        \n        current_chunk.extend(words)\n        current_word_count += sentence_word_count\n    \n    if current_chunk:\n        chunks.append(' '.join(current_chunk))\n    \n    return chunks\n\ndef call_tts_api_curl(chunk_text, voice=VOICE, retry=0):\n    try:\n        print(f\"  [API] Chunk: {chunk_text[:30]}... (retry={retry})\")\n        \n        json_payload = f'{{ \"text\": \"{chunk_text}\", \"voice\": \"{voice}\" }}'\n        \n        result = subprocess.run(\n            [\n                'curl',\n                '--location',\n                TTS_API_URL,\n                '--header', 'Content-Type: application/json',\n                '--data', json_payload,\n                '--silent',\n                '--max-time', '30'\n            ],\n            capture_output=True,\n            timeout=35\n        )\n        \n        if result.returncode == 0:\n            content = result.stdout\n            \n            if content.startswith(b'{'):\n                print(f\"  ✗ Error: {content.decode()[:50]}\")\n                return None\n            elif content.startswith(b'RIFF'):\n                print(f\"  ✓ Success: {len(content)} bytes\")\n                return content\n            else:\n                print(f\"  ✗ Unknown: {content[:50]}\")\n                return None\n        else:\n            print(f\"  ✗ Curl error: {result.stderr.decode()[:50]}\")\n            return None\n            \n    except Exception as e:\n        print(f\"  ✗ Exception: {str(e)}\")\n        return None\n\ndef tts_chunk_with_retry(chunk_idx, chunk_text, max_retries=RETRY_COUNT):\n    for attempt in range(max_retries):\n        audio = call_tts_api_curl(chunk_text, retry=attempt)\n        if audio:\n            return (chunk_idx, audio)\n        \n        if attempt < max_retries - 1:\n            time.sleep(1)\n    \n    print(f\"  ✗ FAILED after {max_retries} retries\")\n    return (chunk_idx, None)\n\ndef concat_wav_ffmpeg(audio_chunks, output_path):\n    temp_files = []\n    \n    for idx, audio_bytes in sorted(audio_chunks, key=lambda x: x[0]):\n        if audio_bytes is None:\n            print(f\"  ⚠ Skipping chunk {idx} (failed)\")\n            continue\n        \n        try:\n            temp_path = tempfile.NamedTemporaryFile(suffix=\".wav\", delete=False)\n            temp_path.write(audio_bytes)\n            temp_path.close()\n            temp_files.append(temp_path.name)\n            print(f\"  ✓ Saved chunk {idx}\")\n        except Exception as e:\n            print(f\"  ✗ Error saving chunk {idx}: {str(e)}\")\n    \n    if not temp_files:\n        print(\"  ✗ No audio chunks to concatenate!\")\n        return False\n    \n    concat_file = tempfile.NamedTemporaryFile(mode='w', suffix='.txt', delete=False)\n    for temp_file in temp_files:\n        concat_file.write(f\"file '{temp_file}'\\n\")\n    concat_file.close()\n    \n    print(f\"\\n  [ffmpeg] Concatenating {len(temp_files)} chunks...\")\n    \n    try:\n        result = subprocess.run(\n            ['ffmpeg', '-f', 'concat', '-safe', '0', '-i', concat_file.name, '-c', 'copy', output_path, '-y'],\n            capture_output=True,\n            timeout=60\n        )\n        \n        if result.returncode == 0:\n            print(f\"  ✓ ffmpeg success!\")\n            return True\n        else:\n            print(f\"  ✗ ffmpeg error\")\n            return False\n    except Exception as e:\n        print(f\"  ✗ Exception: {str(e)}\")\n        return False\n    finally:\n        try:\n            Path(concat_file.name).unlink()\n            for f in temp_files:\n                Path(f).unlink()\n        except:\n            pass\n\n# Main\ntext = \"\"\"Báo cáo tin công nghệ. Tuần này chứng kiến bước ngoặt mới trong cuộc tranh chấp AI khi CEO Nvidia Jensen Huang công khai tuyên bố công ty đang rút lui khỏi OpenAI và Anthropic. Tuy nhiên, căng thẳng giữa Anthropic và OpenAI tiếp tục leo thang khi Dario Amodei gọi lời tuyên bố của OpenAI về thỏa thuận quân sự là nói dối trắng trợn. Cuộc tranh cãi quay quanh câu hỏi cơ bản: liệu OpenAI có thực sự giữ nguyên tắc an toàn hay chỉ là chiến lược PR để che đậy thỏa thuận quân sự. Các công ty quốc phòng đang chuyển sang các nhà cung cấp AI khác hoặc tự phát triển giải pháp nội bộ. Bên cạnh cuộc chiến chính trị, ngành đang chứng kiến sự dịch chuyển sang các mô hình độc lập hơn. Tại Việt Nam, các tin tức công nghệ cho thấy quan tâm ngày càng tăng về các vấn đề an ninh mạng liên quan đến AI. Tuần này làm nổi bật một xu hướng lo ngại: khi các quyết định chính trị và quân sự bắt đầu quyết định ai kiếm được hợp đồng AI lớn, thị trường bắt đầu phân mảnh. Nvidia đang bước ra khỏi cuộc chơi. Các công ty quốc phòng đang chuyển hướng. Các startup mới đang nhảy vào để giải quyết vấn đề độ tin cậy. Cuộc chạy đua AI không còn chỉ là về công nghệ mà về ai có khả năng điều phối các lợi ích chính trị, quân sự, và thương mại cùng một lúc.\"\"\"\n\nprint(\"\\n\" + \"=\"*60)\nprint(\"TTS CHUNKED AUDIO GENERATOR (curl + ffmpeg)\")\nprint(\"=\"*60)\n\nprint(\"\\n[Step 1] Splitting text into chunks...\")\nchunks = split_into_chunks(text, CHUNK_SIZE)\nprint(f\"  → Total chunks: {len(chunks)}\")\nfor i, chunk in enumerate(chunks[:3]):\n    print(f\"    {i}: {chunk[:50]}...\")\n\nprint(f\"\\n[Step 2] Calling TTS API (max_workers={MAX_WORKERS})...\")\naudio_chunks = []\n\nwith ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:\n    futures = {\n        executor.submit(tts_chunk_with_retry, idx, chunk): idx\n        for idx, chunk in enumerate(chunks)\n    }\n    \n    for future in as_completed(futures):\n        try:\n            result = future.result()\n            audio_chunks.append(result)\n        except Exception as e:\n            print(f\"  ✗ Thread error: {str(e)}\")\n\nsuccess_count = len([c for c in audio_chunks if c[1] is not None])\nprint(f\"  → Received {success_count}/{len(chunks)} chunks\")\n\nprint(\"\\n[Step 3] Concatenating audio chunks...\")\noutput_file = \"/tmp/ai_news_final.wav\"\nif concat_wav_ffmpeg(audio_chunks, output_file):\n    file_size = Path(output_file).stat().st_size\n    print(f\"\\n✅ Audio file ready: {output_file}\")\n    print(f\"  Size: {file_size / 1024:.1f} KB\")\nelse:\n    print(\"\\n❌ Audio generation failed\")\nEOF\n\npython3 /tmp/test_chunked.py","timeout":300}}],"api":"anthropic-messages","provider":"anthropic","model":"claude-haiku-4-5-20251001","usage":{"input":3,"output":2552,"cacheRead":0,"cacheWrite":167797,"totalTokens":170352,"cost":{"input":0.000003,"output":0.01276,"cacheRead":0,"cacheWrite":0.20974625000000002,"total":0.22250925000000002}},"stopRea